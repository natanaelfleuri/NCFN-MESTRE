#!/usr/bin/env python3
import os as _os
import sys as _sys

_VENV = _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), '..', '.venv', 'bin', 'python')
if _os.path.exists(_VENV) and _os.path.realpath(_sys.prefix) != _os.path.realpath(_os.path.join(_os.path.dirname(_VENV), '..')):
    _os.execv(_VENV, [_VENV, *_sys.argv])
"""mestre-pc: controle da área de trabalho (X11) para o MESTRE.

  mestre-pc screen                    tamanho da tela
  mestre-pc screenshot [arquivo.png]  captura a tela (padrão /tmp/mestre-tela.png)
  mestre-pc windows                   lista as janelas abertas (id, título)
  mestre-pc focus <trecho do título>  traz a janela para frente
  mestre-pc fullscreen <título> [--off|--toggle]  tela cheia na janela
  mestre-pc fill <título> [--off|--toggle]  ocupa o monitor sem tela cheia (a barra de tarefas aparece por cima)
  mestre-pc minimize <título>         minimiza a janela
  mestre-pc click X Y [left|right|double]
  mestre-pc move X Y
  mestre-pc scroll N                  N>0 desce, N<0 sobe
  mestre-pc type "texto"              digita o texto
  mestre-pc key ctrl+l                atalho de teclado (ctrl, alt, shift, super, enter, tab, esc, f1…)
  mestre-pc open <programa|url|arquivo>   sites abrem dividindo a tela: navegador 2/3, MESTRE 1/3;
                                      os seguintes viram abas na mesma janela
  mestre-pc unsplit                   desfaz a divisão (MESTRE volta a ocupar o monitor)
  mestre-pc camera [arquivo.jpg] [--dispositivo N]   foto da webcam (padrão /tmp/mestre-camera.jpg)
  mestre-pc clipboard                 mostra o texto da área de transferência
  mestre-pc clipboard set "texto"     copia o texto para a área de transferência
  mestre-pc volume [N|+N|-N|mudo]     volume do som (0-100)
  mestre-pc media play|pause|proxima|anterior
"""
import os
import re
import shutil
import subprocess
import sys
import time

def _detect_display():
    # A sessão gráfica pode ser :0, :1…: usa a que tem soquete aberto.
    try:
        socks = sorted(f for f in os.listdir('/tmp/.X11-unix') if f.startswith('X'))
        return ':' + socks[0][1:] if socks else ':0'
    except OSError:
        return ':0'


os.environ.setdefault('DISPLAY', _detect_display())
os.environ.setdefault('XAUTHORITY', f"/run/user/{os.getuid()}/gdm/Xauthority")


def screen_size():
    from Xlib import display
    s = display.Display().screen()
    return s.width_in_pixels, s.height_in_pixels


def screenshot(path='/tmp/mestre-tela.png'):
    from PIL import ImageGrab
    img = ImageGrab.grab(xdisplay=os.environ['DISPLAY'])
    # Reduz telas grandes: a imagem vai para o modelo ler.
    if img.width > 1600:
        img = img.resize((1600, round(img.height * 1600 / img.width)))
    img.save(path)
    print(f'{path} ({img.width}x{img.height}; coordenadas reais = x*{screen_size()[0] / img.width:.3f})')


def windows():
    from Xlib import X, display
    d = display.Display()
    root = d.screen().root
    net_list = d.intern_atom('_NET_CLIENT_LIST')
    net_name = d.intern_atom('_NET_WM_NAME')
    utf8 = d.intern_atom('UTF8_STRING')
    ids = root.get_full_property(net_list, X.AnyPropertyType).value
    out = []
    for wid in ids:
        w = d.create_resource_object('window', wid)
        try:
            prop = w.get_full_property(net_name, utf8)
            name = prop.value.decode('utf-8', 'replace') if prop else (w.get_wm_name() or '')
        except Exception:
            name = ''
        if name:
            out.append((wid, name))
    return out


def find_window(fragment):
    """(id, título): título exatamente igual primeiro; senão, que contenha o trecho."""
    frag = fragment.lower()
    wins = windows()
    for wid, name in wins:
        if name.lower() == frag:
            return wid, name
    for wid, name in wins:
        if frag in name.lower():
            return wid, name
    return None, None


def focus(fragment):
    from Xlib import X, display, protocol
    wid, name = find_window(fragment)
    for wid, name in ([(wid, name)] if wid else []):
        if True:
            d = display.Display()
            root = d.screen().root
            w = d.create_resource_object('window', wid)
            ev = protocol.event.ClientMessage(
                window=w, client_type=d.intern_atom('_NET_ACTIVE_WINDOW'), data=(32, [2, X.CurrentTime, 0, 0, 0]))
            root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
            d.flush()
            print(f'focada: {name}')
            return
    print(f'nenhuma janela com "{fragment}"')
    sys.exit(1)


def _decorations(d, wid, on):
    """Liga/desliga a barra de título do gerenciador de janelas (_MOTIF_WM_HINTS)."""
    win = d.create_resource_object('window', wid)
    atom = d.intern_atom('_MOTIF_WM_HINTS')
    win.change_property(atom, atom, 32, [2, 0, 1 if on else 0, 0, 0])


def fill(fragment, on=1):
    """Ocupa o monitor inteiro sem ser tela cheia: sem barra de título e 1 px mais
    baixa que o monitor. Assim a barra de tarefas (que se oculta sozinha) continua
    aparecendo por cima ao encostar o mouse; em tela cheia o Zorin não a mostra,
    e trata como tela cheia qualquer janela sem borda do tamanho exato do monitor.
    on: 1 ocupa, 0 volta a uma janela normal, 2 alterna."""
    from Xlib import display
    wid, name = find_window(fragment)
    if not wid:
        print(f'nenhuma janela com "{fragment}"')
        sys.exit(1)
    d = display.Display()
    x, y, w, h = _monitor_of(d, wid)
    win = d.create_resource_object('window', wid)
    if on == 2:
        g = win.get_geometry()
        on = 0 if g.width >= w - 2 and g.height >= h - 3 else 1
    if on:
        _decorations(d, wid, False)
        _move_resize(d, wid, x, y, w, h - 1)
    else:
        _decorations(d, wid, True)
        _move_resize(d, wid, x + w // 8, y + h // 10, w * 3 // 4, h * 4 // 5)
    d.flush()
    print(f'{"ocupando o monitor" if on else "janela normal"}: {name}')


def fullscreen(fragment, on=True):
    """Pede ao gerenciador de janelas a tela cheia (_NET_WM_STATE_FULLSCREEN)."""
    from Xlib import X, display, protocol
    wid, name = find_window(fragment)
    for wid, name in ([(wid, name)] if wid else []):
        if True:
            d = display.Display()
            root = d.screen().root
            w = d.create_resource_object('window', wid)
            ev = protocol.event.ClientMessage(
                window=w, client_type=d.intern_atom('_NET_WM_STATE'),
                data=(32, [on if isinstance(on, int) else 1, d.intern_atom('_NET_WM_STATE_FULLSCREEN'), 0, 1, 0]))
            root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
            d.flush()
            print(f'tela cheia {["desligada", "ligada", "alternada"][on]}: {name}')
            return
    print(f'nenhuma janela com "{fragment}"')
    sys.exit(1)


def minimize(fragment):
    from Xlib import X, display, protocol
    wid, name = find_window(fragment)
    for wid, name in ([(wid, name)] if wid else []):
        if True:
            d = display.Display()
            root = d.screen().root
            w = d.create_resource_object('window', wid)
            ev = protocol.event.ClientMessage(window=w, client_type=d.intern_atom('WM_CHANGE_STATE'),
                                              data=(32, [3, 0, 0, 0, 0]))  # IconicState
            root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
            d.flush()
            print(f'minimizada: {name}')
            return
    sys.exit(1)


SPLIT_STATE = f'/tmp/mestre-split-{os.getuid()}.json'


def _wm_state(d, wid, action, *atoms):
    """_NET_WM_STATE: action 0 tira, 1 põe."""
    from Xlib import X, protocol
    root = d.screen().root
    w = d.create_resource_object('window', wid)
    names = [d.intern_atom(a) for a in atoms] + [0]
    ev = protocol.event.ClientMessage(window=w, client_type=d.intern_atom('_NET_WM_STATE'),
                                      data=(32, [action, names[0], names[1], 1, 0]))
    root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)


def _move_resize(d, wid, x, y, w, h):
    from Xlib import X, protocol
    root = d.screen().root
    win = d.create_resource_object('window', wid)
    for pair in (('_NET_WM_STATE_FULLSCREEN', ''), ('_NET_WM_STATE_MAXIMIZED_VERT', '_NET_WM_STATE_MAXIMIZED_HORZ')):
        _wm_state(d, wid, 0, *[a for a in pair if a])
    d.flush()
    time.sleep(0.25)
    flags = 1 | (0xF << 8)  # gravidade noroeste + x, y, largura e altura
    ev = protocol.event.ClientMessage(window=win, client_type=d.intern_atom('_NET_MOVERESIZE_WINDOW'),
                                      data=(32, [flags, int(x), int(y), int(w), int(h)]))
    root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
    d.flush()


def _monitor_of(d, wid):
    """Retângulo (x, y, w, h) do monitor onde está a janela, descontando o painel."""
    from Xlib import X
    root = d.screen().root
    win = d.create_resource_object('window', wid)
    g = win.get_geometry()
    pos = win.translate_coords(root, 0, 0)
    cx, cy = -pos.x + g.width // 2, -pos.y + g.height // 2
    mons = root.xrandr_get_monitors().monitors
    m = next((m for m in mons if m.x <= cx < m.x + m.width_in_pixels and m.y <= cy < m.y + m.height_in_pixels),
             next((m for m in mons if m.primary), mons[0]))
    x, y, w, h = m.x, m.y, m.width_in_pixels, m.height_in_pixels
    try:  # área útil: tira barras/painéis que encostam neste monitor
        wa = root.get_full_property(d.intern_atom('_NET_WORKAREA'), X.AnyPropertyType).value[:4]
        bottom = min(y + h, wa[1] + wa[3])
        top = max(y, wa[1])
        if bottom - top > h * 0.6:
            y, h = top, bottom - top
    except Exception:
        pass
    return x, y, w, h


def _browser():
    try:
        desk = subprocess.run(['xdg-settings', 'get', 'default-web-browser'], capture_output=True, text=True).stdout.strip()
    except OSError:
        desk = ''
    for name, cmd in (('brave', 'brave-browser'), ('chrome', 'google-chrome'), ('chromium', 'chromium'),
                      ('firefox', 'firefox'), ('vivaldi', 'vivaldi'), ('edge', 'microsoft-edge')):
        if name in desk and shutil.which(cmd):
            return cmd
    return next((c for c in ('brave-browser', 'google-chrome', 'firefox', 'chromium') if shutil.which(c)), None)


def open_split(url):
    """Primeira página: janela nova do navegador em 2/3 e o MESTRE em 1/3 do mesmo
    monitor. As seguintes: abas na mesma janela."""
    import json as _json
    from Xlib import display
    browser = _browser()
    if not browser:
        subprocess.Popen(['xdg-open', url], start_new_session=True)
        return print(f'abrindo {url}')
    d = display.Display()
    try:
        state = _json.load(open(SPLIT_STATE))
    except (OSError, ValueError):
        state = {}
    alive = {wid for wid, _ in windows()}
    if state.get('wid') in alive:
        focus_id(state['wid'])
        time.sleep(0.3)
        subprocess.Popen([browser, url], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return print(f'aberto em nova aba: {url}')
    before = alive
    subprocess.Popen([browser, '--new-window', url], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    new = None
    for _ in range(40):
        time.sleep(0.25)
        fresh = [(wid, name) for wid, name in windows() if wid not in before]
        if fresh:
            new = fresh[-1][0]
            break
    mestre, _ = find_window('MESTRE')
    if not new or not mestre:
        return print(f'abrindo {url} (sem dividir a tela: {"janela do navegador não encontrada" if not new else "MESTRE fechado"})')
    restore_window(d, mestre)  # tira o MESTRE do minimizado, se estiver
    time.sleep(0.4)
    x, y, w, h = _monitor_of(d, mestre)
    big = round(w * 2 / 3)
    _move_resize(d, new, x, y, big, h)
    _move_resize(d, mestre, x + big, y, w - big, h)
    time.sleep(0.3)
    focus_id(new)
    _json.dump({'wid': new, 'monitor': [x, y, w, h]}, open(SPLIT_STATE, 'w'))
    print(f'aberto dividindo a tela (navegador 2/3, MESTRE 1/3): {url}')


def split_check():
    """Se a janela da divisão foi fechada, devolve o MESTRE à tela cheia."""
    import json as _json
    try:
        state = _json.load(open(SPLIT_STATE))
    except (OSError, ValueError):
        return
    if state.get('wid') not in {wid for wid, _ in windows()}:
        unsplit()


def unsplit():
    from Xlib import display
    d = display.Display()
    mestre, _ = find_window('MESTRE')
    if mestre:
        fill('MESTRE')
    try:
        os.remove(SPLIT_STATE)
    except OSError:
        pass
    print('MESTRE de volta ao monitor inteiro')


def restore_window(d, wid):
    """Desminimiza e traz para frente (o pedido de ativação sozinho pode ser ignorado)."""
    # O Mutter ignora "ativar" vindo de outro programa, mas desminimiza a janela
    # que recebe tela cheia: liga a tela cheia; o redimensionamento a tira depois.
    _wm_state(d, wid, 1, '_NET_WM_STATE_FULLSCREEN')
    d.flush()
    focus_id(wid)


def focus_id(wid):
    from Xlib import X, display, protocol
    d = display.Display()
    root = d.screen().root
    w = d.create_resource_object('window', wid)
    ev = protocol.event.ClientMessage(window=w, client_type=d.intern_atom('_NET_ACTIVE_WINDOW'),
                                      data=(32, [2, X.CurrentTime, 0, 0, 0]))
    root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
    d.flush()


def mouse():
    from pynput.mouse import Controller
    return Controller()


def click(x, y, kind='left'):
    from pynput.mouse import Button
    m = mouse()
    m.position = (int(x), int(y))
    time.sleep(0.05)
    if kind == 'double':
        m.click(Button.left, 2)
    else:
        m.click(Button.right if kind == 'right' else Button.left, 1)
    print(f'clique {kind} em {x},{y}')


KEYS = {
    'ctrl': 'ctrl', 'control': 'ctrl', 'alt': 'alt', 'shift': 'shift', 'super': 'cmd', 'win': 'cmd',
    'enter': 'enter', 'return': 'enter', 'tab': 'tab', 'esc': 'esc', 'escape': 'esc', 'space': 'space',
    'backspace': 'backspace', 'delete': 'delete', 'up': 'up', 'down': 'down', 'left': 'left', 'right': 'right',
    'home': 'home', 'end': 'end', 'pageup': 'page_up', 'pagedown': 'page_down',
}


def key(combo):
    from pynput.keyboard import Controller, Key
    kb = Controller()
    parts = [p.strip().lower() for p in combo.split('+') if p.strip()]
    resolved = []
    for p in parts:
        name = KEYS.get(p, p)
        if hasattr(Key, name):
            resolved.append(getattr(Key, name))
        elif len(p) == 1:
            resolved.append(p)
        else:
            print(f'tecla desconhecida: {p}')
            sys.exit(1)
    for k in resolved[:-1]:
        kb.press(k)
    kb.press(resolved[-1])
    kb.release(resolved[-1])
    for k in reversed(resolved[:-1]):
        kb.release(k)
    print(f'teclas {combo}')


def camera(path='/tmp/mestre-camera.jpg', device=0):
    import cv2
    cap = cv2.VideoCapture(int(device))
    if not cap.isOpened():
        print(f'câmera {device} indisponível')
        sys.exit(1)
    for _ in range(8):  # deixa a exposição se ajustar
        cap.read()
    ok, frame = cap.read()
    cap.release()
    if not ok:
        print('não consegui capturar a imagem')
        sys.exit(1)
    cv2.imwrite(path, frame)
    print(f'{path} ({frame.shape[1]}x{frame.shape[0]})')


def clipboard(args):
    import tkinter
    if args and args[0] == 'set':
        text = ' '.join(args[1:])
        # O Tk só mantém o conteúdo enquanto está vivo: um processo à parte
        # segura a área de transferência até outro programa copiar algo.
        if os.fork() == 0:
            os.setsid()
            r = tkinter.Tk()
            r.withdraw()
            r.clipboard_clear()
            r.clipboard_append(text)
            r.update()
            r.after(3600 * 1000, r.destroy)
            r.mainloop()
            os._exit(0)
        print('copiado')
        return
    r = tkinter.Tk()
    r.withdraw()
    try:
        print(r.clipboard_get())
    except tkinter.TclError:
        print('(área de transferência vazia ou sem texto)')
    r.destroy()


def volume(arg=None):
    sink = '@DEFAULT_AUDIO_SINK@'
    if arg in ('mudo', 'mute'):
        subprocess.run(['wpctl', 'set-mute', sink, 'toggle'])
    elif arg:
        if arg[0] in '+-':
            subprocess.run(['wpctl', 'set-volume', '-l', '1.0', sink, f'{abs(int(arg))}%{arg[0]}'])
        else:
            subprocess.run(['wpctl', 'set-volume', '-l', '1.0', sink, f'{max(0, min(100, int(arg)))}%'])
    out = subprocess.run(['wpctl', 'get-volume', sink], capture_output=True, text=True).stdout.strip()
    print(out.replace('Volume:', 'volume').replace('[MUTED]', '(mudo)'))


def media(action):
    from pynput.keyboard import Controller, Key
    keys = {'play': Key.media_play_pause, 'pause': Key.media_play_pause, 'tocar': Key.media_play_pause,
            'proxima': Key.media_next, 'próxima': Key.media_next, 'anterior': Key.media_previous}
    k = keys.get(action)
    if not k:
        print('use: play, pause, proxima, anterior')
        sys.exit(1)
    kb = Controller()
    kb.press(k)
    kb.release(k)
    print(f'mídia: {action}')


def main(argv):
    if not argv or argv[0] in ('-h', '--help', 'help'):
        print(__doc__)
        return
    cmd, args = argv[0], argv[1:]
    if cmd == 'screen':
        print('%dx%d' % screen_size())
    elif cmd == 'screenshot':
        screenshot(*(args[:1] or []))
    elif cmd == 'windows':
        for wid, name in windows():
            print(f'{wid:#x}\t{name}')
    elif cmd == 'focus':
        focus(' '.join(args))
    elif cmd == 'fullscreen':
        on = 2 if '--toggle' in args else 0 if '--off' in args else 1  # _NET_WM_STATE: 0 tira, 1 põe, 2 alterna
        fullscreen(' '.join(a for a in args if not a.startswith('--')), on=on)
    elif cmd == 'fill':
        on = 2 if '--toggle' in args else 0 if '--off' in args else 1
        fill(' '.join(a for a in args if not a.startswith('--')), on=on)
    elif cmd == 'minimize':
        minimize(' '.join(args))
    elif cmd == 'click':
        click(*args[:3])
    elif cmd == 'move':
        mouse().position = (int(args[0]), int(args[1]))
    elif cmd == 'scroll':
        mouse().scroll(0, -int(args[0]))
    elif cmd == 'type':
        from pynput.keyboard import Controller
        Controller().type(' '.join(args))
        print('digitado')
    elif cmd == 'key':
        key(args[0])
    elif cmd == 'camera':
        dev = 0
        if '--dispositivo' in args:
            k = args.index('--dispositivo')
            dev = args[k + 1]
            args = args[:k] + args[k + 2:]
        camera(*(args[:1] or []), device=dev)
    elif cmd == 'clipboard':
        clipboard(args)
    elif cmd == 'volume':
        volume(args[0] if args else None)
    elif cmd == 'media':
        media(args[0] if args else '')
    elif cmd == 'unsplit':
        unsplit()
    elif cmd == 'open':
        target = ' '.join(args)
        if re.match(r'https?://', target) or target.lower().endswith(('.html', '.htm')):
            open_split(target if '://' in target else 'file://' + os.path.abspath(os.path.expanduser(target)))
        elif '://' in target or os.path.exists(os.path.expanduser(target)):
            subprocess.Popen(['xdg-open', os.path.expanduser(target)], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f'abrindo {target}')
        else:
            subprocess.Popen(['gtk-launch', target], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f'abrindo {target}')
    elif cmd == 'split-check':
        split_check()
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == '__main__':
    main(sys.argv[1:])
